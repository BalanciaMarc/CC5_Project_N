-- Alter
ALTER TABLE CALENDAR
    DROP COLUMN year,
    DROP COLUMN month_name,
    DROP COLUMN week_label,
    ALTER COLUMN time_description TYPE DATE USING time_description::DATE,
    ALTER COLUMN time_description SET NOT NULL,
    ADD CONSTRAINT uq_calendar_time_description UNIQUE (time_description);

ALTER TABLE ACCOUNT
    ADD COLUMN country_id INT,
    ADD COLUMN subscription_id INT;

UPDATE ACCOUNT
SET country_id = CASE country_name
        WHEN 'Philippines' THEN 1
        WHEN 'France' THEN 2
        WHEN 'USA' THEN 3
        WHEN 'Canada' THEN 4
    END,
    subscription_id = CASE subscription_type
        WHEN 'Basic' THEN 1
        WHEN 'Standard' THEN 2
        WHEN 'Premium' THEN 3
    END;

ALTER TABLE ACCOUNT
    ALTER COLUMN country_id SET NOT NULL,
    ALTER COLUMN subscription_id SET NOT NULL,
    ADD CONSTRAINT uq_account_username UNIQUE (username),
    ADD CONSTRAINT fk_account_country FOREIGN KEY (country_id) REFERENCES COUNTRY(country_id),
    ADD CONSTRAINT fk_account_subscription FOREIGN KEY (subscription_id) REFERENCES SUBSCRIPTION_TYPE(subscription_id),
    DROP COLUMN country_name,
    DROP COLUMN subscription_type;

ALTER TABLE MOVIE
    RENAME COLUMN movie_description TO description;

ALTER TABLE MOVIE
    ALTER COLUMN duration TYPE NUMERIC(5,1),
    ADD CONSTRAINT chk_movie_duration CHECK (duration > 0);

ALTER TABLE STREAM
    ALTER COLUMN completion_date SET NOT NULL;

ALTER TABLE RATING
    ALTER COLUMN rating TYPE NUMERIC(3,1),
    ADD CONSTRAINT chk_rating_range CHECK (rating BETWEEN 0 AND 10);
