
-- FILMQUEST DATABASE (3NF)

-- 1. CALENDAR
CREATE TABLE CALENDAR (
    time_id INT PRIMARY KEY,
    calendar_date DATE NOT NULL UNIQUE
);

-- 2. ACCOUNT
CREATE TABLE ACCOUNT (
    user_id INT PRIMARY KEY,
    username VARCHAR(50) NOT NULL UNIQUE,
    country_name VARCHAR(50) NOT NULL,
    registration_date DATE NOT NULL,
    subscription_type VARCHAR(20) NOT NULL,
    CHECK (subscription_type IN ('Basic', 'Standard', 'Premium'))
);

-- 3. MOVIE
CREATE TABLE MOVIE (
    movie_id INT PRIMARY KEY,
    title VARCHAR(255) NOT NULL,
    genre VARCHAR(50) NOT NULL,
    movie_description VARCHAR(500) NOT NULL,
    duration NUMERIC(5,1) NOT NULL CHECK (duration > 0),
    release_date DATE NOT NULL
);

-- 4. STREAM
CREATE TABLE STREAM (
    stream_id INT PRIMARY KEY,
    user_id INT NOT NULL,
    movie_id INT NOT NULL,
    time_id INT NOT NULL,
    completion_date TIMESTAMP NOT NULL,

    FOREIGN KEY (user_id) REFERENCES ACCOUNT(user_id),
    FOREIGN KEY (movie_id) REFERENCES MOVIE(movie_id),
    FOREIGN KEY (time_id) REFERENCES CALENDAR(time_id)
);

-- 5. RATING
CREATE TABLE RATING (
    rating_id INT PRIMARY KEY,
    movie_id INT NOT NULL,
    user_id INT NOT NULL,
    rating NUMERIC(3,1) NOT NULL CHECK (rating BETWEEN 0 AND 10),
    review VARCHAR(1000) NOT NULL,

    FOREIGN KEY (movie_id) REFERENCES MOVIE(movie_id),
    FOREIGN KEY (user_id) REFERENCES ACCOUNT(user_id),
    UNIQUE (user_id, movie_id)
);
