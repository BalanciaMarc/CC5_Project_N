CREATE TABLE CALENDAR (
    time_id INT NOT NULL,
    calendar_date DATE NOT NULL,
    CONSTRAINT pk_time PRIMARY KEY (time_id),
    CONSTRAINT uq_calendar_date UNIQUE (calendar_date)
);

CREATE TABLE ACCOUNT (
    user_id INT NOT NULL,
    username VARCHAR(50) NOT NULL,
    country_name VARCHAR(50) NOT NULL,
    registration_date DATE NOT NULL,
    subscription_type VARCHAR(20) NOT NULL,
    CONSTRAINT pk_user PRIMARY KEY (user_id),
    CONSTRAINT uq_username UNIQUE (username),
    CONSTRAINT chk_subscription
        CHECK (subscription_type IN ('Basic', 'Standard', 'Premium'))
);

CREATE TABLE MOVIE (
    movie_id INT NOT NULL,
    title VARCHAR(255) NOT NULL,
    genre VARCHAR(50) NOT NULL,
    movie_description VARCHAR(500) NOT NULL,
    duration NUMERIC(5,1) NOT NULL,
    release_date DATE NOT NULL,
    CONSTRAINT pk_movie PRIMARY KEY (movie_id),
    CONSTRAINT chk_duration CHECK (duration > 0)
);

CREATE TABLE STREAM (
    stream_id INT NOT NULL,
    user_id INT NOT NULL,
    movie_id INT NOT NULL,
    time_id INT NOT NULL,
    completion_date TIMESTAMP NOT NULL,
    CONSTRAINT pk_stream PRIMARY KEY (stream_id),
    CONSTRAINT fk_stream_user
        FOREIGN KEY (user_id)
        REFERENCES ACCOUNT(user_id)
        ON UPDATE CASCADE
        ON DELETE RESTRICT,
    CONSTRAINT fk_stream_movie
        FOREIGN KEY (movie_id)
        REFERENCES MOVIE(movie_id)
        ON UPDATE CASCADE
        ON DELETE RESTRICT,
    CONSTRAINT fk_stream_time
        FOREIGN KEY (time_id)
        REFERENCES CALENDAR(time_id)
        ON UPDATE CASCADE
        ON DELETE RESTRICT
);

CREATE TABLE RATING (
    rating_id INT NOT NULL,
    movie_id INT NOT NULL,
    user_id INT NOT NULL,
    rating NUMERIC(3,1) NOT NULL,
    review VARCHAR(1000) NOT NULL,
    CONSTRAINT pk_rating PRIMARY KEY (rating_id),
    CONSTRAINT fk_rating_movie
        FOREIGN KEY (movie_id)
        REFERENCES MOVIE(movie_id)
        ON UPDATE CASCADE
        ON DELETE RESTRICT,
    CONSTRAINT fk_rating_user
        FOREIGN KEY (user_id)
        REFERENCES ACCOUNT(user_id)
        ON UPDATE CASCADE
        ON DELETE RESTRICT,
    CONSTRAINT uq_rating_user_movie
        UNIQUE (user_id, movie_id),
    CONSTRAINT chk_rating
        CHECK (rating BETWEEN 0 AND 10)
);


