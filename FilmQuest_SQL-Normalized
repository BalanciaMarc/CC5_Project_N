CREATE VIEW calendar_details AS
SELECT
    time_id,
    calendar_date,
    EXTRACT(YEAR FROM calendar_date) AS year,
    TO_CHAR(calendar_date, 'FMMonth') AS month_name,
    'Week ' || EXTRACT(WEEK FROM calendar_date) AS week_label,
    TO_CHAR(calendar_date, 'FMDay') AS time_description
FROM CALENDAR;


