Use SchoolDB;
Select count(*) As TotalNumberofStudents,
max(grade) as HighestGrade,
min(grade) As LowestGrade,
round(AVG(Grade),2) As AverageGrade
From Enrollment;

-- 2
SELECT S.StudentName, AVG(E.Grade) AS AverageGrade 
FROM Student S
JOIN Enrollment E ON S.StudentID = E.StudentID 
GROUP BY S.StudentID, S.StudentName 
HAVING AVG(E.Grade) > 90;

