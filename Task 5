-- Generate a summary report containing: 
Select * From Enrollment;
Select * From Student;
Select * From Subject;

Select count(*) As TotalNumberofSubjects
From Subject;

Select count(*) As TotalNumberofEnrollments
From enrollment;

Select count(*) As TotalNumberofStudents,
max(grade) as HighestGrade,
min(grade) As LowestGrade,
round(AVG(Grade),2) As AverageGrade
From Enrollment;

SELECT 
COUNT(DISTINCT StudentID) AS TotalNumberOfStudents,
COUNT(DISTINCT SubjectID) AS TotalNumberOfSubjects,
COUNT(*) AS TotalNumberOfEnrollments,
MAX(Grade) AS HighestGrade,
MIN(Grade) AS LowestGrade,
ROUND(AVG(Grade), 2) AS AverageGrade
FROM Enrollment;
