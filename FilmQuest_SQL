-- FILMQUEST - SQL

-- CREATE TABLE
CREATE TABLE CALENDAR (
    time_id INT NOT NULL,
    year INT NOT NULL,
    month_name VARCHAR(20) NOT NULL,
    week_label VARCHAR(20) NOT NULL,
    time_description VARCHAR(50) NOT NULL,
    CONSTRAINT pk_time PRIMARY KEY (time_id)
);

CREATE TABLE ACCOUNT (
    user_id INT NOT NULL,
    username VARCHAR(50) NOT NULL,
    country_name VARCHAR(50),
    registration_date DATE NOT NULL,
    subscription_type VARCHAR(20) NOT NULL,
    CONSTRAINT pk_user PRIMARY KEY (user_id)
);

CREATE TABLE MOVIE (
    movie_id INT NOT NULL,
    movie_description VARCHAR(500) NOT NULL,
    title VARCHAR(255) NOT NULL,
    genre VARCHAR(50) NOT NULL,
    duration INT,
    release_date DATE,
    CONSTRAINT pk_movie PRIMARY KEY (movie_id)
);

CREATE TABLE STREAM (
    stream_id INT NOT NULL,
    user_id INT NOT NULL,
    movie_id INT NOT NULL,
    time_id INT NOT NULL,
    completion_date TIMESTAMP,
    CONSTRAINT pk_stream PRIMARY KEY (stream_id),
    CONSTRAINT fk_stream_user FOREIGN KEY (user_id) REFERENCES ACCOUNT (user_id),
    CONSTRAINT fk_stream_movie FOREIGN KEY (movie_id) REFERENCES MOVIE (movie_id),
    CONSTRAINT fk_stream_time FOREIGN KEY (time_id) REFERENCES CALENDAR (time_id)
);

CREATE TABLE RATING (
    rating_id INT NOT NULL,
    movie_id INT NOT NULL,
    user_id INT NOT NULL,
    rating FLOAT NOT NULL,
    review VARCHAR(1000),
    CONSTRAINT pk_rating PRIMARY KEY (rating_id),
    CONSTRAINT fk_rating_movie FOREIGN KEY (movie_id) REFERENCES MOVIE(movie_id),
    CONSTRAINT fk_rating_user FOREIGN KEY (user_id) REFERENCES ACCOUNT(user_id),
    CONSTRAINT uq_rating_user_movie UNIQUE (user_id, movie_id)
);

